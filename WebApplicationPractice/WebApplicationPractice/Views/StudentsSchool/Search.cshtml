
@{
    ViewBag.Title = "Search";
}

<h2>Search</h2>

@if (Model.Count > 0)
{
    <table class="table table-bordered">
        <tr>
            <th>Id</th>
            <th>FullName</th>
            <th>StudentId</th>
            <th>Email</th>
            <th>Age</th>
            <th>EnrollmentDate</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FullName</td>
                <td>@item.StudentId</td>
                <td>@item.Email</td>
                <td>@item.Age</td>
                <td>@item.EnrollmentDate</td>
                <td>
                    </tr>
        }
     </table>
}
else
{
<h1>No data found.</h1>
}