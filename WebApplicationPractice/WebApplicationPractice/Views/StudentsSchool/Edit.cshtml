
@{
    ViewBag.Title = "Edit";
}

<h2>Edit</h2>
<form method="post">
    <input type="hidden" value="@Model.Id" name="Id" />
    <input type="text" value="@Model.FullName" name="FullName" placeholder="Full Name" class="form form-control " />
    <input type="text" value="@Model.StudentId" name="StudentId" placeholder="Student Id" class="form form-control" />
    <input type="email" value="@Model.Email" name="Email" placeholder="Email" class="from form-control" />
    <input type="date" value="@Model.Age" name="Age" placeholder="Age" class="form form-control" />
    <input type="date" value="@Model.EnrollmentDate" name="EnrollmentDate" placeholder="Enrollment Date"class="form form-control" />
    <input type="submit" value="Create" class="btn btn-success" />

</form>
