

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>
<form method="get" action="/StudentsSchool/search">
    <input type="text" name="Id" class="form form-control" placeholder="Search by name" />
    <input type="submit" value="Search" class="btn btn-secondary" />

</form>

@if (Model.Count > 0)
{   
    <table class="table table-bordered">
        <tr>
            <th>Id</th>
            <th>FullName</th>
            <th>StudentId</th>
            <th>Email</th>
            <th>Age</th>
            <th>EnrollmentDate</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FullName</td>
                <td>@item.StudentId</td>
                <td>@item.Email</td>
                <td>@item.Age</td>
                <td>@item.EnrollmentDate</td>
                <td>
                    <a href="/studentsschool/details/@item.Id" class="btn btn-dark">Details</a>
                    <a href="/studentsschool/edit/@item.Id" class="btn btn-success">Edit</a>
                    <a href="/studentsschool/delete/@item.Id" class="btn btn-danger"onclick="return confirm('Are you sure you want to delete @item.FullName ?');">Delete</a>
                </td>
            </tr>
        }
    </table>

}

else
{ <h1>No Data Found</h1>
}