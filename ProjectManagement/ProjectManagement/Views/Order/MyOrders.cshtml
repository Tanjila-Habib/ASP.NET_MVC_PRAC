
@{
    ViewBag.Title = "MyOrders";
}

<h2>MyOrders</h2>
<table class="table table-bordered">
    @foreach (var item in Model)
    {
        <tr>
            <th>Id</th>
            <th>Amount</th>
            <th>Status</th>
        </tr>
        <tr>
            <td>@item.Id</td>
            <td>@item.Amount</td>
            <td>@item.Status</td>
            <td>
                @if (item.Status == "Ordered")
                {
                    <a href="/Order/CancelOrder/@item.Id" class="btn btn-danger btn-sm">
                        Cancel Order
                    </a>
                }
            </td>
        </tr>
    }
</table>